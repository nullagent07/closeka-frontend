# ----- App -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Closeka"

# ----- Clerk (auth) -----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ----- Postmark (transactional + inbound) -----
POSTMARK_API_TOKEN=""
POSTMARK_FROM_EMAIL="closeka@yourdomain.com"
POSTMARK_INBOUND_SECRET=""

# ----- Stripe (billing) -----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_GROWTH=""
STRIPE_PRICE_ID_SCALE=""

# ----- LiteLLM proxy (LLM + OCR) -----
# Single proxy exposes all model providers via OpenAI-compatible API.
# Get the virtual key from your LiteLLM admin dashboard.
LITELLM_BASE_URL="https://litellm-production-33a41.up.railway.app"
LITELLM_API_KEY=""
# Model names must match the ones configured in your LiteLLM deployment.
# Default chat / analyzer: DeepSeek Flash (fast, cheap)
LITELLM_MODEL_SMALL="deepseek/deepseek-v4-flash"
# Escalation for hard cases
LITELLM_MODEL_ESCALATION="openrouter/anthropic/claude-haiku-4.5"
# Document OCR (PDF / image)
LITELLM_MODEL_OCR="mistral/mistral-ocr-latest"
# Generic completion
LITELLM_MODEL_COMPLETION="deepseek/deepseek-v4-flash"

# ----- Vercel Cron secret (for /api/cron/*) -----
CRON_SECRET=""

# ----- Resend (optional alternative to Postmark) -----
RESEND_API_KEY=""
